            "method": "GET",
            "url": "https://public-api.drata.com/public/v2/controls"
          },
          "docs": "List controls"
        },
        {
          "info": {
            "name": "Get a control",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.drata.com/public/v2/controls/:controlId",
            "params": [
              {
                "name": "controlId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a control"
        }
      ]
    }
  ],
  "bundled": true
}