{
  "opencollection": "1.0.0",
  "info": {
    "name": "Drata Public API v2 Assets Controls API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Controls",
        "type": "folder"
      },
      "items": [
